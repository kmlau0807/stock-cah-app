# Copy this file to ".env" and fill in your SMTP details.
# Then `python main.py run --email` will email the daily report.
# Never commit the real .env (it holds your password).

# --- Email delivery (SMTP) ---
CAH_EMAIL_ENABLED=true
CAH_SMTP_HOST=smtp.gmail.com
CAH_SMTP_PORT=587
CAH_SMTP_USER=you@gmail.com
CAH_SMTP_PASS=your-app-password
CAH_EMAIL_FROM=you@gmail.com
CAH_EMAIL_TO=you@gmail.com

# --- Optional: market cap filter (0 = off). Value in billions (HKD-equivalent). ---
CAH_MIN_MARKET_CAP_B=0
